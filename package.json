{
  "name": "g4t0xx-modmenu",
  "version": "2.0.0-preview.1",
  "description": "Gerenciador autoral de jogos e mods locais com backups.",
  "author": "Gabriel Sorensen",
  "license": "MIT",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "42.3.2",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.g4t0xx.modmenu",
    "productName": "G4T0XX Modmenu",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "G4T0XX-Modmenu-${version}-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "G4T0XX-Modmenu-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "npmRebuild": false
  }
}
